    <worksheet name='Q5 Cancellation ส่งผลต่อ average net margin ต่อ booking ที่ “สำเร็จจริง” แค่ไหน'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Cancellation Has Minimal Impact on Net Margin per Completed Booking</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='fact_bookings+ (hotel_channel_profitability_v2)' name='federated.17ii4od1whgvxq13k0mhp00twpbp' />
          </datasources>
          <datasource-dependencies datasource='federated.17ii4od1whgvxq13k0mhp00twpbp'>
            <column caption='Net_Margin' datatype='real' name='[Calculation_0873624677253120]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([net_room_revenue]) / SUM([gross_room_revenue]) * 100' />
            </column>
            <column caption='Cancellation Rate' datatype='real' name='[Calculation_0873624701788172]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [status] = &quot;Cancelled&quot; THEN 1 ELSE 0 END)&#13;&#10;/ COUNTD([booking_id])' />
            </column>
            <column caption='% Impact' datatype='real' name='[Calculation_0873624706109457]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;AVG(&#13;&#10;IF [status] != &quot;Cancelled&quot; THEN [net_margin] END&#13;&#10;)&#13;&#10;-&#13;&#10;AVG([net_margin])&#13;&#10;)&#13;&#10;/&#13;&#10;AVG([net_margin])' />
            </column>
            <column caption='Booking Id' datatype='string' name='[booking_id]' role='dimension' type='nominal' />
            <column caption='Channel Type' datatype='string' name='[channel_type]' role='dimension' type='nominal' />
            <column-instance column='[booking_id]' derivation='Count' name='[cnt:booking_id:qk]' pivot='key' type='quantitative' />
            <column caption='Gross Room Revenue' datatype='real' name='[gross_room_revenue]' role='measure' type='quantitative' />
            <column caption='Net Margin' datatype='real' name='[net_margin]' role='measure' type='quantitative' />
            <column caption='Net Room Revenue' datatype='real' name='[net_room_revenue]' role='measure' type='quantitative' />
            <column-instance column='[channel_type]' derivation='None' name='[none:channel_type:nk]' pivot='key' type='nominal' />
            <column caption='Status' datatype='string' name='[status]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_0873624677253120]' derivation='User' name='[usr:Calculation_0873624677253120:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0873624701788172]' derivation='User' name='[usr:Calculation_0873624701788172:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0873624706109457]' derivation='User' name='[usr:Calculation_0873624706109457:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <encoding attr='space' class='0' field='[federated.17ii4od1whgvxq13k0mhp00twpbp].[usr:Calculation_0873624701788172:qk]' field-type='quantitative' fold='true' scope='rows' type='space' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <style>
              <style-rule element='pane'>
                <format attr='minwidth' value='184' />
                <format attr='maxwidth' value='184' />
                <format attr='minheight' value='287' />
                <format attr='maxheight' value='287' />
                <format attr='aspect' value='0' />
              </style-rule>
            </style>
          </pane>
          <pane id='3' selection-relaxation-option='selection-relaxation-allow' y-axis-name='[federated.17ii4od1whgvxq13k0mhp00twpbp].[usr:Calculation_0873624677253120:qk]'>
