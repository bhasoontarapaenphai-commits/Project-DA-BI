      <aliases enabled='yes' />
      <column caption='Revenue ไม่มี OTA' datatype='real' name='[Calculation_0699901907992576]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;IF [Calculation_0699901919711237] = &quot;Non-OTA&quot;&#13;&#10;THEN [net_room_revenue]&#13;&#10;END&#13;&#10;)' />
      </column>
      <column caption='OTARevenue Loss (เงินที่หายไป)' datatype='real' name='[Calculation_0699901908275201]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;IF [channel_type] = &quot;OTA&quot;&#13;&#10;THEN [net_room_revenue]&#13;&#10;END&#13;&#10;)' />
      </column>
      <column caption='Margin ถ้าไม่มี OTA' datatype='real' name='[Calculation_0699901911986179]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(&#13;&#10;IF [channel_type] = &quot;Direct&quot;&#13;&#10;THEN [net_margin]&#13;&#10;END&#13;&#10;)' />
      </column>
      <column caption='Margin Improvement' datatype='real' name='[Calculation_0699901912342532]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(&#13;&#10;IF [channel_type] = &quot;Direct&quot;&#13;&#10;THEN [net_margin]&#13;&#10;END&#13;&#10;)&#13;&#10;-&#13;&#10;AVG([net_margin])' />
      </column>
      <column caption='OTA Flag' datatype='string' name='[Calculation_0699901919711237]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [channel_id] IN (&quot;Agoda&quot;,&quot;Booking&quot;,&quot;Expedia&quot;) THEN &quot;OTA&quot;&#13;&#10;ELSE &quot;Non-OTA&quot;&#13;&#10;END' />
      </column>
      <column caption='Net_Margin' datatype='real' name='[Calculation_0873624677253120]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([net_room_revenue]) / SUM([gross_room_revenue]) * 100' />
      </column>
      <column caption='Channel Type (OTA vs Direct)' datatype='string' name='[Calculation_0873624679694337]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [channel_name] IN (&quot;Agoda&quot;,&quot;Booking.com&quot;,&quot;Expedia&quot;) THEN &quot;OTA&quot;&#13;&#10;ELSE &quot;Direct&quot;&#13;&#10;END' />
      </column>
      <column caption='เทียบ channel vs OTA' datatype='real' name='[Calculation_0873624684802055]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;AVG([net_margin])&#13;&#10;-&#13;&#10;AVG({ FIXED : AVG(IF [channel_type] = &quot;OTA&quot; THEN [net_margin] END) })&#13;&#10;)&#13;&#10;/&#13;&#10;AVG({ FIXED : AVG(IF [channel_type] = &quot;OTA&quot; THEN [net_margin] END) })' />
      </column>
      <column caption='OTA Avg Margin' datatype='real' name='[Calculation_0873624685899784]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : AVG(IF [channel_type] = &quot;OTA&quot; THEN [net_margin] END) }' />
      </column>
      <column caption='Calculation1' datatype='real' name='[Calculation_0873624685953033]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;AVG([net_margin]) - AVG([Calculation_0873624685899784])&#13;&#10;)&#13;&#10;/ AVG([Calculation_0873624685899784])' />
      </column>
      <column caption='Net Revenue per Booking' datatype='real' name='[Calculation_0873624697606155]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([net_room_revenue]) / COUNTD([booking_id])' />
      </column>
      <column caption='Cancellation Rate' datatype='real' name='[Calculation_0873624701788172]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [status] = &quot;Cancelled&quot; THEN 1 ELSE 0 END)&#13;&#10;/ COUNTD([booking_id])' />
      </column>
      <column caption='Realized Revenueหลัง cancel' datatype='real' name='[Calculation_0873624703762445]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;IF [status] != &quot;Cancelled&quot; THEN [net_room_revenue] END&#13;&#10;)' />
      </column>
      <column caption='Lost Revenue' datatype='real' name='[Calculation_0873624703971342]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;IF [status] = &quot;Cancelled&quot; THEN [net_room_revenue] END&#13;&#10;)' />
      </column>
      <column caption='Revenue Loss Rate' datatype='real' name='[Calculation_0873624704036879]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;IF [channel_id] IN (&quot;Agoda&quot;,&quot;Booking&quot;,&quot;Expedia&quot;)&#13;&#10;THEN [net_room_revenue]&#13;&#10;END&#13;&#10;)&#13;&#10;/ SUM([net_room_revenue])' />
      </column>
      <column caption='Avg Net Margin (Completed only)' datatype='real' name='[Calculation_0873624705998864]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(&#13;&#10;IF [status] != &quot;Cancelled&quot; THEN [net_margin] END&#13;&#10;)' />
      </column>
      <column caption='% Impact' datatype='real' name='[Calculation_0873624706109457]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;AVG(&#13;&#10;IF [status] != &quot;Cancelled&quot; THEN [net_margin] END&#13;&#10;)&#13;&#10;-&#13;&#10;AVG([net_margin])&#13;&#10;)&#13;&#10;/&#13;&#10;AVG([net_margin])' />
      </column>
      <column caption='Commission Rate (%)' datatype='real' name='[Calculation_0873624709365778]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([commission_amount]) / SUM([gross_room_revenue])' />
      </column>
      <column caption='booking idcount' datatype='integer' name='[Calculation_1621018835222528]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [status] = &quot;Checked-Out&quot; THEN [booking_id] END)' />
      </column>
